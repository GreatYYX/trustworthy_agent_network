# OpenAI (GPT) models
OPENAI_API_KEY=sk-...

# Anthropic (Claude) models
ANTHROPIC_API_KEY=sk-ant-...

# Optional OpenAI-compatible API base URL.
# Leave unset to use the default OpenAI endpoint.
# API_URL=https://api.openai.com/v1

# Model id (examples: gpt-4o-mini, gpt-4o, claude-sonnet-4-20250514)
MODEL=gpt-4o-mini
